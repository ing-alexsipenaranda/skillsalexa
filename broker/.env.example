# HTTPS public origin of this service, behind a TLS reverse proxy.
BROKER_ORIGIN=
SUPABASE_URL=https://melhdrdiesgeotzhkazg.supabase.co
SUPABASE_PUBLISHABLE_KEY=
OAUTH_CLIENT_ID=evoll-alexa
# Generate independently and store securely. Never commit.
OAUTH_CLIENT_SECRET=
# Base64 encoding of 32 random bytes. Keep stable: changing loses stored sessions.
TOKEN_ENCRYPTION_KEY=
# Exact redirect URLs shown in Alexa Developer Console, separated by commas.
ALEXA_REDIRECT_URIS=
# Durable private volume, not an ephemeral deployment directory.
BROKER_DB=/data/evoll-alexa.sqlite
BIND_HOST=127.0.0.1
PORT=3000
